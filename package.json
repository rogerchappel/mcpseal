{
  "name": "mcpseal",
  "version": "0.1.0",
  "description": "Local-first MCP config risk linter for agent server definitions.",
  "type": "module",
  "bin": {
    "mcpseal": "./dist/src/cli.js"
  },
  "main": "./dist/src/index.js",
  "exports": {
    ".": "./dist/src/index.js"
  },
  "files": [
    "dist/src",
    "examples",
    "README.md",
    "LICENSE",
    "schemas",
    "SECURITY.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "CODE_OF_CONDUCT.md"
  ],
  "scripts": {
    "build": "tsc",
    "check": "tsc --noEmit",
    "test": "npm run build && node --test dist/tests/*.test.js",
    "smoke": "npm run build && bash scripts/smoke.sh",
    "package:smoke": "node scripts/package-smoke.mjs",
    "release:tag-check": "node scripts/check-release-tag.mjs",
    "test:release-tag": "node --test scripts/check-release-tag.test.mjs",
    "release:check": "npm test && npm run test:release-tag && npm run check && npm run build && npm run smoke && npm run package:smoke"
  },
  "keywords": [
    "mcp",
    "security",
    "cli",
    "agent-tools",
    "linter"
  ],
  "author": "Roger Chappel",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^22.15.18",
    "typescript": "^5.8.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rogerchappel/mcpseal.git"
  },
  "bugs": {
    "url": "https://github.com/rogerchappel/mcpseal/issues"
  },
  "homepage": "https://github.com/rogerchappel/mcpseal#readme"
}
